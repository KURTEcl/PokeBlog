{
  "name": "pokeblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pokémon TCG blog on EmDash with an interactive Phaser home room",
  "emdash": {
    "label": "PokeBlog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "pnpm --filter @poke-emdash/scene-core test",
    "postinstall": "node scripts/import-essentials-assets.mjs",
    "import:essentials": "node scripts/import-essentials-assets.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "6.0.1",
    "@emdash-cms/plugin-audit-log": "^0.2.0",
    "@poke-emdash/plugin-pokemon-tcg": "workspace:*",
    "@poke-emdash/plugin-scene-builder": "workspace:*",
    "@poke-emdash/plugin-theme-settings": "workspace:*",
    "@poke-emdash/scene-core": "workspace:*",
    "astro": "^7.0.0",
    "better-sqlite3": "^12.8.0",
    "emdash": "^0.28.1",
    "phaser": "^4.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.35.3"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
