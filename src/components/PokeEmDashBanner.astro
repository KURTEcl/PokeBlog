---
/**
 * Open-source install banner for PokeBlog / EmDash.
 */
const repoUrl = "https://github.com/KURTEcl/PokeBlog";
const emdashUrl = "https://emdashcms.com";
---

<aside class="poke-emdash-banner" aria-label="Try PokeBlog on EmDash">
	<p class="poke-emdash-banner__eyebrow">OPEN SOURCE</p>
	<p class="poke-emdash-banner__title">Start your Pokémon TCG blog</p>
	<p class="poke-emdash-banner__text">
		Interactive room home + decklists, tournaments, and posts on EmDash.
	</p>
	<a class="poke-emdash-banner__cta" href={repoUrl} target="_blank" rel="noopener noreferrer">
		Clone PokeBlog
	</a>
	<a class="poke-emdash-banner__link" href={emdashUrl} target="_blank" rel="noopener noreferrer">
		EmDash docs
	</a>
</aside>

<style>
	.poke-emdash-banner {
		margin: 1.5rem 0;
		padding: 1.25rem;
		border: 1px solid color-mix(in srgb, var(--color-border, #ccc) 80%, transparent);
		background: color-mix(in srgb, var(--color-surface, #f8f8f8) 90%, transparent);
	}
	.poke-emdash-banner__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.7;
	}
	.poke-emdash-banner__title {
		margin: 0 0 0.35rem;
		font-size: 1.1rem;
		font-weight: 600;
	}
	.poke-emdash-banner__text {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
		opacity: 0.85;
	}
	.poke-emdash-banner__cta {
		display: inline-block;
		margin-right: 0.75rem;
		padding: 0.4rem 0.85rem;
		border-radius: 0.35rem;
		background: var(--color-accent, #2563eb);
		color: #fff;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
	}
	.poke-emdash-banner__cta:hover {
		filter: brightness(1.05);
	}
	.poke-emdash-banner__link {
		font-size: 0.85rem;
		color: inherit;
		opacity: 0.8;
	}
	.poke-emdash-banner__link:hover {
		opacity: 1;
	}
</style>
