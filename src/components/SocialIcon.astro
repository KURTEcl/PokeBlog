---
interface Props {
	name: string;
}

const value = Astro.props.name.toLowerCase();
const network = value.includes("instagram") ? "instagram"
	: value.includes("youtube") || value.includes("youtu.be") ? "youtube"
	: value.includes("twitch") ? "twitch"
	: value.includes("facebook") || value.includes("fb.com") ? "facebook"
	: value.includes("tiktok") ? "tiktok"
	: value.includes("github") ? "github"
	: value.includes("twitter") || value.includes("x.com") ? "x"
	: value.includes("rss") ? "rss"
	: "link";
---

<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	{network === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill"/></>}
	{network === "youtube" && <><path d="M21 8.2a3 3 0 0 0-2.1-2.1C17 5.6 12 5.6 12 5.6s-5 0-6.9.5A3 3 0 0 0 3 8.2 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8Z"/><path d="m10 9 5 3-5 3Z" class="fill"/></>}
	{network === "twitch" && <path d="M5 3h16v11l-5 5h-4l-3 3v-3H5V3Zm3 3v10h3v2l2-2h4l2-2V6H8Zm3 2h2v5h-2V8Zm4 0h2v5h-2V8Z"/>}
	{network === "facebook" && <path d="M14 21v-8h3l.5-3H14V8.5c0-.9.3-1.5 1.7-1.5H18V4.2c-.4-.1-1.7-.2-2.8-.2C12.5 4 11 5.6 11 8.2V10H8v3h3v8h3Z" class="fill"/>}
	{network === "tiktok" && <path d="M15 3c.4 2.2 1.7 3.5 4 4v3a8 8 0 0 1-4-1.2v6.1A6.1 6.1 0 1 1 9.8 9v3.1a3.1 3.1 0 1 0 2.2 3V3h3Z" class="fill"/>}
	{network === "github" && <path d="M12 2a10 10 0 0 0-3.2 19.5v-2.3c-2.7.6-3.3-1.1-3.3-1.1-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.8.8.1-.7.4-1.1.6-1.3-2.2-.2-4.5-1.1-4.5-4.9 0-1.1.4-2 1-2.7-.1-.2-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.5.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.7-4.5 4.9.4.3.7.9.7 1.8v3.1A10 10 0 0 0 12 2Z" class="fill"/>}
	{network === "x" && <path d="M5 4h4.5l3.3 4.4L16.6 4H19l-5.1 6.1L20 20h-4.5l-3.7-4.9L7.6 20H5.2l5.5-6.6L5 4Zm3.3 2 8.3 12h1.1L9.4 6H8.3Z" class="fill"/>}
	{network === "rss" && <><circle cx="6" cy="18" r="1.5" class="fill"/><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/></>}
	{network === "link" && <><path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.2 1.2"/><path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.2-1.2"/></>}
</svg>

<style>
	.social-icon {
		display: block;
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.fill {
		fill: currentColor;
		stroke: none;
	}
</style>
